# ForgeFlow product API configuration for deploy/docker-compose.yml.
# Copy this file to .env in this directory and edit the values before starting:
#   cp .env.example .env

# Recorded runs are mounted read-only at /data/runs by docker-compose.yml.
FORGEFLOW_DATA_ROOT=/data/runs

# Approval records are written to the forgeflow-approvals named volume.
FORGEFLOW_APPROVALS_ROOT=/data/approvals

# Session signing secret, at least 32 characters. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# The placeholder is intentionally too short so startup fails until replaced.
FORGEFLOW_SESSION_SECRET=replace-me

# Comma-separated invite codes, each at least 16 characters. Rotate them by
# editing this value and recreating the service; see deploy/README.md.
FORGEFLOW_INVITE_CODES=replace-invite-code-alpha,replace-invite-code-bravo

# Keep false for local plain HTTP. Set true when served behind TLS.
FORGEFLOW_SECURE_COOKIE=false
