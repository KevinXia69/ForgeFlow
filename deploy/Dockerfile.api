# ForgeFlow read-only review image.
#
# The image contains no model key and no ERP credential. It serves a curated
# demo-runs subset (baked in) and writes approval records only to a temporary
# path that Render discards between instances.

# ---- React workbench build ----
FROM node:22-slim AS web
WORKDIR /build
COPY web ./web
RUN cd web && npm install --no-audit --no-fund && npm run build

# ---- API runtime ----
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV HOME=/tmp \
    FORGEFLOW_DATA_ROOT=/app/demo-runs \
    FORGEFLOW_APPROVALS_ROOT=/tmp/approvals \
    FORGEFLOW_KNOWLEDGE_ROOT=/app \
    FORGEFLOW_DEPLOYMENT=review \
    FORGEFLOW_RUNNER_ENABLED=false

WORKDIR /app

# Copy only what the wheel and the review UI need; local runs, caches and
# secrets never enter the image even though the build context is the repo.
COPY pyproject.toml ./
COPY src ./src
COPY README.md ./
COPY docs ./docs
COPY contracts ./contracts
COPY demo-runs ./demo-runs
COPY --from=web /build/src/forgeflow/api/static/app ./src/forgeflow/api/static/app

# Pin the versions resolved in uv.lock for the API surface only.
RUN pip install --no-cache-dir . \
    "fastapi==0.152.0" \
    "uvicorn[standard]==0.54.0" \
    "cryptography==50.0.2"

# Unprivileged runtime identity.
RUN groupadd --gid 10001 forgeflow \
    && useradd --uid 10001 --gid 10001 --no-create-home \
        --shell /bin/false forgeflow \
    && mkdir -p /tmp/approvals \
    && chown -R 10001:10001 /tmp/approvals

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"]

# No ENTRYPOINT: Render's dockerCommand replaces CMD only, so the command must
# live in CMD to let a platform override it without prepending an entrypoint.
CMD ["forgeflow", "api", "--host", "0.0.0.0"]
