[Unit]
Description=Renew the ForgeFlow short-lived public IP certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/forgeflow-certbot/bin/certbot renew --cert-name forgeflow-ip --quiet --deploy-hook "/usr/sbin/nginx -t && /usr/bin/systemctl reload nginx"
