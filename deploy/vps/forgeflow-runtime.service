[Unit]
Description=ForgeFlow isolated API and executor supervisor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/forgeflow
EnvironmentFile=/etc/forgeflow/runtime.env
ExecStart=/opt/forgeflow/.venv/bin/python -m forgeflow.vps_runtime --config /etc/forgeflow/runtime.json
Restart=on-failure
RestartSec=10
UMask=0077
RuntimeDirectory=forgeflow
RuntimeDirectoryMode=0711
KillMode=mixed
TimeoutStopSec=960
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/forgeflow
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# The root supervisor creates setgid evidence directories so API-written
# snapshots inherit the DSH read group. RestrictSUIDSGID blocks that chmod.
RestrictSUIDSGID=false
# sudo is constrained to forgeflow-dsh; NoNewPrivileges would prevent that UID
# transition. The root supervisor launches the API with no supplementary groups.
NoNewPrivileges=false
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
