# Copy this file to .env and set your Nebius Token Factory API key locally.
# Never paste API keys into chat or commit .env.
NEBIUS_API_KEY=

# Verified through the provider model listing; user-selected model.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
