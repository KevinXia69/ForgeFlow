# Copy this file to .env and fill in the keys you need locally.
# Never paste API keys into chat or commit .env.
NEBIUS_API_KEY=

# Verified through the provider model listing; user-selected model.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# Read-only assistant ("Ask" and case questions). The default keeps the
# historical Nebius binding; deepseek_flash switches only the Q&A harness.
# The investigation/Pi runtime above stays on the Nebius configuration.
FORGEFLOW_ASSISTANT_PROFILE=nemotron
DEEPSEEK_API_KEY=
